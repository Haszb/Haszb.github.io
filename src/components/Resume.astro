---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  resume: CollectionEntry<'resume'>;
}

const { lang, resume } = Astro.props;
const r = resume.data;
// French pages fall back to the English file until a French one exists
const contentLang = resume.id;
const langNote = contentLang !== lang ? t(lang, 'resume.langNote') : '';
---

<header class="resume-head">
  <div>
    <h2 id="resume-title">
      {t(lang, 'resume.title')}
      {langNote && <span class="lang-note">({langNote})</span>}
    </h2>
    <p class="meta" lang={contentLang}>{r.availability}</p>
  </div>
  <a class="download" href={r.pdf} download="Hassan-Zbib-resume.pdf" hreflang="en">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path d="M12 3.5v11m0 0-4.5-4.5M12 14.5l4.5-4.5M4.5 16.5v3h15v-3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {t(lang, 'resume.download')}
  </a>
</header>

<div class="resume" lang={contentLang}>
  <section aria-label={t(lang, 'resume.experience')}>
    <h3 class="label">{t(lang, 'resume.experience')}</h3>
    <ol class="entries">
      {
        r.experience.map((job) => (
          <li>
            <div class="entry-head">
              <p class="entry-title">
                <strong>{job.title}</strong>
                <span>{job.company}</span>
              </p>
              <p class="entry-when meta">
                <span class="mono">{job.period}</span>
                <span>{job.place}</span>
              </p>
            </div>
            {job.intro && <p class="entry-intro justified">{job.intro}</p>}
            {job.bullets.length > 0 && (
              <ul class="bullets justified">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-label={t(lang, 'resume.education')}>
    <h3 class="label">{t(lang, 'resume.education')}</h3>
    <ol class="entries">
      {
        r.education.map((ed) => (
          <li>
            <div class="entry-head">
              <p class="entry-title">
                <strong>{ed.degree}</strong>
                <span>{ed.school}</span>
              </p>
              <p class="entry-when meta">
                <span class="mono">{ed.period}</span>
                <span>{ed.place}</span>
              </p>
            </div>
            {ed.details && <p class="entry-intro justified">{ed.details}</p>}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-label={t(lang, 'resume.skills')}>
    <h3 class="label">{t(lang, 'resume.skills')}</h3>
    <dl class="skills">
      {
        r.skills.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>
              {s.items}
              {s.link && (
                <a class="proof" href={s.link} hreflang="en">
                  {t(lang, 'resume.link')}
                  <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                    <path d="M8 6h10v10M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</div>

<style>
  .resume-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .resume-head > div {
    display: grid;
    gap: 0.6rem;
  }

  h2 {
    font-size: var(--step-2);
  }

  .lang-note {
    margin-left: 0.4em;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .download:hover {
    border-color: var(--accent);
  }

  /* Dates sit in a left rail (as in the article list); the text fills the column to its right */
  .resume {
    --rail: 11rem;
    --rail-gap: 2rem;
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.25rem);
  }

  .resume section {
    display: grid;
    gap: 1.25rem;
  }

  .resume h3 {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .entries {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entries > li {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 0.6rem var(--rail-gap);
  }

  .entries > li > * {
    grid-column: 2;
  }

  /* Its title and dates become cells of the entry grid */
  .entry-head {
    display: contents;
  }

  .entry-title {
    grid-column: 2;
    grid-row: 1;
  }

  .entry-title,
  .entry-when {
    display: grid;
    gap: 0.1rem;
  }

  .entry-title strong {
    font-weight: 600;
    color: var(--ink);
  }

  .entry-title span {
    color: var(--ink-2);
  }

  .entry-when {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    padding-top: 0.2rem;
  }

  .entry-intro {
    color: var(--ink-2);
  }

  .bullets {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
  }

  .bullets li::marker {
    color: var(--muted);
  }

  .skills {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .skills > div {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 0.25rem var(--rail-gap);
  }

  .skills dt {
    font-weight: 600;
  }

  /* Lining figures, so codes like SAA-C03 keep their digits at capital height */
  .skills dd {
    margin: 0;
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
  }

  /* A link to the credential, after its name */
  .proof {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.75rem;
    white-space: nowrap;
  }

  /* Phones: one column, the dates under the title */
  @media (max-width: 44rem) {
    .entries > li {
      grid-template-columns: minmax(0, 1fr);
    }

    .entries > li > *,
    .entry-title,
    .entry-when {
      grid-column: 1;
      grid-row: auto;
    }

    .entry-when {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.75rem;
      padding-top: 0;
    }

    .skills > div {
      grid-template-columns: 1fr;
    }
  }
</style>
