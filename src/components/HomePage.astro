---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';
import ArticleList from './ArticleList.astro';
import Resume from './Resume.astro';
import { t, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const profile = await getEntry('profile', lang);
if (!profile) throw new Error(`Missing src/content/profile/${lang}.md`);
const { Content: Summary } = await render(profile);

const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const academic = projects.filter((p) => !p.data.featured);

const articles = (await getCollection('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const p = profile.data;

// French falls back to the English resume until it is written
const resume = (await getEntry('resume', lang)) ?? (await getEntry('resume', 'en'));
if (!resume) throw new Error('Missing src/content/resume/en.yaml');

// The tab bar under the intro. The first tab opens when the URL has no #fragment.
const tabs: { id: string; label: UiKey }[] = [
  { id: 'projects', label: 'nav.projects' },
  { id: 'resume', label: 'nav.resume' },
  { id: 'writing', label: 'nav.writing' },
];

// The brand marks are Simple Icons 9.21.0 paths (CC0), drawn in the text colour.
const icons = {
  email: 'M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm.4 2L12 12.4 21.6 6zM2 8.1V18h20V8.1l-10 6.7z',
  linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  github: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  medium: 'M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z',
};

// The links under the photo
const introLinks = [
  { label: t(lang, 'contact.email'), href: `mailto:${p.email}`, external: false, icon: icons.email },
  { label: 'GitHub', href: p.github, external: true, icon: icons.github },
  { label: 'LinkedIn', href: p.linkedin, external: true, icon: icons.linkedin },
  { label: 'Medium', href: p.medium, external: true, icon: icons.medium },
];

const title = `${p.name} · ${p.role}`;
// Under the photo the role reads as two lines, split where the profile writes " - "
const roleLines = p.role.split(' - ');
const description =
  lang === 'fr'
    ? 'Portfolio de Hassan Zbib : NLP, data engineering et data science. Rochondra, analyse de prix Bitcoin et projets de formation.'
    : 'Portfolio of Hassan Zbib: NLP, data engineering and data science. Rochondra, Bitcoin price analysis and training projects.';
---

<BaseLayout lang={lang} title={title} description={description}>
  <section class="intro wrap" aria-labelledby="intro-title">
    <div class="intro-grid">
      <h1 id="intro-title">{p.name}</h1>
      <div class="summary justified">
        <Summary />
      </div>
      <div class="intro-aside">
        <div class="avatar">
          <img src={p.photo} alt={p.photoAlt} width="400" height="500" />
        </div>
        <p class="label role">{roleLines.map((line) => <span>{line}</span>)}</p>
        <ul class="intro-links">
          {
            introLinks.map((link) => (
              <li>
                <a class="arrow-link" href={link.href} data-external={link.external || undefined}>
                  <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={link.icon} />
                  </svg>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="download" href={resume.data.pdf} download="Hassan-Zbib-resume.pdf" hreflang="en">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M12 3.5v11m0 0-4.5-4.5M12 14.5l4.5-4.5M4.5 16.5v3h15v-3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t(lang, 'resume.download')}
        </a>
      </div>
    </div>
  </section>

  <div class="tabs" data-tabs>
  <div class="tabbar-row">
    <div class="wrap">
      <div class="tabbar" aria-label={t(lang, 'tabs.label')}>
        {
          tabs.map((tab) => (
            <a class="tab" id={`tab-${tab.id}`} href={`#${tab.id}`} data-tab={tab.id}>
              {t(lang, tab.label)}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <section id="projects" class="section panel" aria-labelledby="projects-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="projects-title">{t(lang, 'home.featured')}</h2>
      </header>
      <div class="featured">
        {featured.map((project, i) => <FeaturedProject lang={lang} project={project} index={i} />)}
      </div>

      <header class="section-head sub">
        <h3>{t(lang, 'home.academic')}</h3>
        <p>{t(lang, 'home.academicNote')}</p>
      </header>
      <div class="cards">
        {academic.map((project) => <ProjectCard lang={lang} project={project} />)}
      </div>
    </div>
  </section>

  <section id="resume" class="section panel" aria-labelledby="resume-title">
    <div class="wrap">
      <Resume lang={lang} resume={resume} />
    </div>
  </section>

  <section id="writing" class="section panel" aria-labelledby="writing-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="writing-title">{t(lang, 'home.writing')}</h2>
        <p>{t(lang, 'home.writingNote')}</p>
      </header>
      <ArticleList lang={lang} articles={articles} />
    </div>
  </section>
  </div>
</BaseLayout>

<script>
  // Without JavaScript every section stays visible, stacked, and the tabs are plain anchors.
  // With it, one panel shows at a time; the URL fragment names the open tab, so links and the
  // Back button work.
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  const bar = root?.querySelector<HTMLElement>('.tabbar');
  const tabs = [...(root?.querySelectorAll<HTMLAnchorElement>('[data-tab]') ?? [])];
  const ids = tabs.map((tab) => tab.dataset.tab ?? '');
  const panels = ids.map((id) => document.getElementById(id));

  if (root && bar && panels.every(Boolean)) {
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      return ids.includes(id) ? id : null;
    };

    const select = (id: string) => {
      tabs.forEach((tab, i) => {
        const on = ids[i] === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i]!.hidden = !on;
      });
      // Keep the selected tab in view when the bar scrolls sideways
      const selected = tabs[ids.indexOf(id)];
      bar.scrollLeft = selected.offsetLeft - (bar.clientWidth - selected.offsetWidth) / 2;
    };

    // Bring the bar back into view when a link elsewhere on the page opens a tab
    const reveal = () => requestAnimationFrame(() => bar.scrollIntoView({ block: 'start' }));

    bar.setAttribute('role', 'tablist');
    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', ids[i]);
      panels[i]!.setAttribute('role', 'tabpanel');
      panels[i]!.setAttribute('aria-labelledby', tab.id);
    });
    root.classList.add('is-tabbed');

    const initial = fromHash();
    select(initial ?? ids[0]);
    if (initial) reveal();

    const open = (index: number, push: boolean) => {
      const id = ids[index];
      if (push) history.pushState(null, '', `#${id}`);
      else history.replaceState(null, '', `#${id}`);
      select(id);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (tab.getAttribute('aria-selected') !== 'true') open(i, true);
      });
    });

    // Arrow keys move between tabs (WAI-ARIA tabs pattern, automatic activation)
    bar.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((tab) => tab === document.activeElement);
      if (current < 0) return;
      const last = tabs.length - 1;
      const next =
        event.key === 'ArrowRight' ? (current === last ? 0 : current + 1)
        : event.key === 'ArrowLeft' ? (current === 0 ? last : current - 1)
        : event.key === 'Home' ? 0
        : event.key === 'End' ? last
        : -1;
      if (next < 0) return;
      event.preventDefault();
      open(next, false);
      tabs[next].focus();
    });

    window.addEventListener('popstate', () => select(fromHash() ?? ids[0]));
    window.addEventListener('hashchange', () => {
      const id = fromHash();
      if (!id) return;
      select(id);
      reveal();
    });
  }
</script>

<style>
  .intro {
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(3rem, 7vw, 5rem);
  }

  /* Phones: a small headshot beside the name and the role, then the summary and the links full width.
     Wider screens: the photo and the links under it form a right column (see the media query
     below), ending on the right edge of the page frame. */
  .intro-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem clamp(1rem, 2.5vw, 1.6rem);
  }

  /* The photo, the role and the links become cells of the grid above */
  .intro-aside {
    display: contents;
  }

  .avatar {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
  }

  h1 {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
  }

  .role {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
  }

  .summary,
  .intro-links {
    grid-column: 1 / -1;
  }

  .download {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  .download:hover {
    border-color: var(--accent);
  }

  .download svg {
    flex-shrink: 0;
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .summary {
    display: grid;
    gap: 1rem;
    /* Between --step-0 and --step-1 */
    font-size: clamp(1.15rem, 1.08rem + 0.35vw, 1.32rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .summary :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    padding: 0;
    margin: 0.4rem 0 0;
    list-style: none;
  }

  .intro-links .arrow-link {
    font-size: var(--step-0);
  }

  /* Brand marks sized to the text */
  .link-icon {
    align-self: center;
    width: 1em;
    height: 1em;
    margin-right: 0.2em;
    fill: var(--ink-2);
  }

  .role {
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .role span {
    display: block;
  }

  /* On phones the headshot is cropped from the portrait photo to head and shoulders */
  .avatar {
    width: clamp(4.5rem, 7vw, 6.5rem);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transform: scale(1.6);
    transform-origin: 50% 22%;
  }

  /* Two columns: the name and summary, then on the right the photo with the role and the links
     under it. The text never runs under the photo, so its line length stays constant. */
  @media (min-width: 44rem) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      /* The last row absorbs any height difference, so the name's row stays tight */
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }

    h1,
    .summary {
      grid-column: 1;
    }

    h1 {
      align-self: start;
    }

    /* Without this a short summary stretches to the photo column's height and its
       paragraphs drift apart */
    .summary {
      align-self: start;
    }

    .intro-aside {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
      grid-column: 2;
      grid-row: 1 / span 2;
      --photo: clamp(11rem, 17vw, 15rem);
      /* Drops from the name's line box to the top of its capitals */
      margin-top: calc(var(--step-4) * 0.15);
    }

    .avatar {
      width: var(--photo);
      aspect-ratio: 4 / 5;
    }

    .avatar img {
      transform: scale(1.15);
      transform-origin: 50% 0%;
    }

    /* Sits close under the photo, as its caption, its longer line exactly as wide as the photo:
       "Machine Learning & AI" measures 13.8em in Libertinus capitals. The negative margin
       drops the letter-spacing after the last letter, so the column keeps the photo's width. */
    .role {
      margin-top: -0.6rem;
      margin-right: -0.09em;
      font-size: calc(var(--photo) / 13.8);
    }

    /* Close under the role too, so the photo, its caption and the links read as one block */
    .intro-links {
      flex-direction: column;
      margin: -0.6rem 0 0;
    }

    /* As wide as the photo, closing the column a small step below the links. The zero width
       keeps a long label (the French one) from widening the column; it wraps instead. */
    .download {
      width: 0;
      min-width: 100%;
      margin-top: -0.6rem;
      justify-content: center;
      text-align: center;
    }
  }

  /* ---------- Tab bar ----------
     Plain labels on one edge-to-edge rule; the selected one takes full ink and an accent
     underline sitting on the rule. */
  .tabbar-row {
    border-bottom: 1px solid var(--rule);
  }

  /* One line, centred while it fits and scrolling sideways when it does not (the auto
     margins centre without making the start unreachable, unlike justify-content). The bar
     hangs 1px over the row's rule so the underline, clipped by the scroll box, still lands on it,
     and spreads into the gutters so the labels scroll out at the screen edge. */
  .tabbar {
    position: relative;
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin: 0 calc(-1 * var(--gutter)) -1px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .tab:first-child {
    margin-left: auto;
  }

  .tab:last-child {
    margin-right: auto;
  }

  .tab {
    position: relative;
    padding: 0.95rem 0 0.85rem;
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab[aria-selected='true'] {
    color: var(--ink);
  }

  /* The underline sits on the row's bottom rule */
  .tab::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .tab:focus-visible {
    outline-offset: 2px;
  }

  /* A link to #panel lands with the tab bar still visible above it */
  .panel {
    scroll-margin-top: 4.5rem;
  }

  .is-tabbed .panel {
    border-top: 0;
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .featured {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .section-head.sub {
    max-width: none;
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .section-head.sub h3 {
    font-size: var(--step-1);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }
</style>
