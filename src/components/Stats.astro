---
// A row of key figures. Usage in MDX: <Stats items={[{ value: '5,880', label: 'PDFs retrieved' }]} />
interface Props {
  items: { value: string; label: string; note?: string }[];
}

const { items } = Astro.props;
---

<dl class="stats">
  {
    items.map((s) => (
      <div>
        <dd class="mono">{s.value}</dd>
        <dt>{s.label}</dt>
        {s.note && <dd class="note">{s.note}</dd>}
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 2rem 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stats div {
    flex: 1 1 9.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--paper);
  }

  dd {
    margin: 0;
  }

  .mono {
    order: -1;
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  dt {
    font-family: var(--serif);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .note {
    font-family: var(--serif);
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>
