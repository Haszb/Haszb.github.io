---
import type { CollectionEntry } from 'astro:content';
import { formatDate, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  articles: CollectionEntry<'articles'>[];
  compact?: boolean;
}

const { lang, articles, compact = false } = Astro.props;
const langNote = t(lang, 'article.langNote');
---

<ol class:list={['articles', { compact }]}>
  {
    articles.map(({ data: a }) => (
      <li>
        <time class="meta mono" datetime={a.date.toISOString().slice(0, 10)}>
          {formatDate(a.date, lang)}
        </time>
        <div class="text">
          <h3>
            <a href={a.url} hreflang="en" lang="en">
              {a.title}
            </a>
          </h3>
          {!compact && <p class="summary">{a.summary[lang]}</p>}
          <p class="meta">
            {t(lang, 'article.external')} · {a.minutes} {t(lang, 'article.minutes')}
            {langNote && <> · <span class="lang-note">{langNote}</span></>}
          </p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .articles {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.4rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .compact li {
    grid-template-columns: 1fr;
    padding-block: 1rem;
  }

  time {
    padding-top: 0.3rem;
    font-size: 0.8rem;
  }

  .text {
    display: grid;
    gap: 0.45rem;
  }

  h3 {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .compact h3 {
    font-size: var(--step-0);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: ' ↗';
    font-family: var(--serif);
    font-size: 0.7em;
    color: var(--muted);
  }

  .summary {
    color: var(--ink-2);
  }

  .lang-note {
    font-style: italic;
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
