---
import { getCollection } from 'astro:content';
import CasePage from '../../../components/CasePage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id, data }) => id.startsWith('fr/') && data.page);
  return projects.map((project) => ({ params: { slug: project.id.split('/')[1] }, props: { project } }));
}

const { project } = Astro.props;
---

<CasePage lang="fr" project={project} />
